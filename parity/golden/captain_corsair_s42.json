        {
          "event_type": "nothing",
          "message": "Fishing boats dot the horizon — small, colorful, and everywhere. The Mediterranean feeds itself.",
          "hull_delta": 0,
          "provision_delta": 0,
          "silver_delta": 0,
          "crew_delta": 0,
