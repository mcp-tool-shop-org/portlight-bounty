[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

linux.debug.x86_64 = "res://../target/debug/libportlight_godot.so"
linux.release.x86_64 = "res://../target/release/libportlight_godot.so"
windows.debug.x86_64 = "res://../target/debug/portlight_godot.dll"
windows.release.x86_64 = "res://../target/release/portlight_godot.dll"
macos.debug = "res://../target/debug/libportlight_godot.dylib"
macos.release = "res://../target/release/libportlight_godot.dylib"
macos.debug.arm64 = "res://../target/debug/libportlight_godot.dylib"
macos.release.arm64 = "res://../target/release/libportlight_godot.dylib"
