      "events": [
        {
          "event_type": "pirates",
          "message": "Scarlet Ana of the The Crimson Tide blocks your path and demands a duel! Use [bold]portlight duel <stance>[/bold] to fight (thrust/slash/parry, 5 rounds).",
          "hull_delta": 0,
          "provision_delta": 0,
          "silver_delta": 0,
